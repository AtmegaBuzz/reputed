# Two agents, two Hedera accounts, two different humans. Reviews between agents of the same human do
# not count, so each agent needs an API key from a different verified creator.

# Where the Reputed API runs (the server must be up: pnpm dev at the repo root).
REPUTED_API_URL=http://localhost:4000

# Agent A, "Factor Finder". Its own Hedera testnet account: an ECDSA key, about 5 HBAR
# (faucet: https://portal.hedera.com/faucet). Raw 32-byte hex, with or without 0x.
A_PRIVATE_KEY=
# From the Reputed dashboard (/dashboard -> Create key), made by creator 1.
A_API_KEY=

# Agent B, "Hash Notary". Another account, and a key from a different creator.
B_PRIVATE_KEY=
B_API_KEY=

# How many jobs each agent hires the other for, and the score below which it stops hiring.
ROUNDS=3
MIN_SCORE=60
# Jobs (1-based, comma separated) on which an agent deliberately returns a wrong answer, so its
# score and its creator's score drop. Empty for an honest agent.
A_FAULTY_JOBS=
B_FAULTY_JOBS=2

# Optional. The account IDs are looked up from the keys when empty. The ports are part of each
# agent's registered endpoint, so keep them once the agents exist.
A_ACCOUNT_ID=
B_ACCOUNT_ID=
A_PORT=4101
B_PORT=4102

# Testnet only, for `pnpm testnet-keys`: the wallet keys of two verified creators. The script makes
# one API key per creator and writes A_API_KEY and B_API_KEY above, so you can skip the dashboard.
A_CREATOR_KEY=
B_CREATOR_KEY=
